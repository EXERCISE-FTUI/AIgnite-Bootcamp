#!/usr/bin/env bash
echo 'Running checks before push...'

# Run lint
npm run lint
if [ $? -ne 0 ]; then
  echo '❌ Lint failed. Aborting push.'
  exit 1
fi

# Run type-check
npm run type-check
if [ $? -ne 0 ]; then
  echo '❌ Type-check failed. Aborting push.'
  exit 1
fi

echo '✅ All checks passed. Proceeding with push.'
exit 0
